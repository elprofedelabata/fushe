      </espacios>
    </sesion>
    <sesion id="S008" dia="5" perfil="PH02" tramo="T02" actividad="A006">
      <profesores>
        <profesor ref="P002"/>
        <profesor ref="P003"/>
      </profesores>
      <grupos>
        <grupo ref="G002"/>
